{
  "expo": {
    "name": "Mis Cuentas",
    "slug": "mis-cuentas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "miscuentas",
    "userInterfaceStyle": "light",
    "backgroundColor": "#0e1511",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ar.alirio.miscuentas",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Para sacarle una foto al ticket y cargar el gasto.",
        "NSPhotoLibraryUsageDescription": "Para elegir la foto de un ticket y cargar el gasto.",
        "NSSpeechRecognitionUsageDescription": "Para pasar a texto lo que dictás.",
        "NSMicrophoneUsageDescription": "Para que le dictes tus gastos."
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "ar.alirio.miscuentas",
      "adaptiveIcon": {
        "backgroundColor": "#1DEA00",
        "foregroundImage": "./assets/android-icon.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 1000,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "control-de-gastos-lyart-theta.vercel.app",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#0e1511"
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Resumen",
              "label": "Mis Cuentas",
              "description": "Tu disponible y lo que gastaste este mes, con un botón para cargar un gasto.",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 0
            }
          ]
        }
      ],
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.ar.alirio.miscuentas",
          "widgets": [
            {
              "name": "Resumen",
              "displayName": "Mis Cuentas",
              "description": "Tu disponible y lo que gastaste este mes.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium"
              ]
            }
          ]
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Para que le dictes tus gastos.",
          "speechRecognitionPermission": "Para pasar a texto lo que dictás.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.tts"
          ]
        }
      ],
      "./plugins/atajos-android.js",
      "expo-apple-authentication"
    ],
    "extra": {
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "ar.alirio.miscuentas.ExpoWidgetsTarget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.ar.alirio.miscuentas"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "6b8eaef0-9a3d-40f1-bd8b-74b4aceeb76f"
      }
    },
    "owner": "alirior"
  }
}
